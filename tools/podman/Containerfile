# SPDX-License-Identifier: GPL-3.0-or-later
# Quartus Prime Lite 25.1std build image for openfpga-GBC (Cyclone V 5CEBA4F23C8).
#
# Installers are NOT downloaded here. Run tools/podman/fetch-installers.sh first,
# then build with the dl/ directory bind-mounted at /dl (see Makefile `image`).
# This keeps the 3.4 GB of installers out of the image layers and off the
# rebuild path.
FROM docker.io/library/ubuntu:22.04

ARG QVER=25.1std.0
ARG QBUILD=1129
ARG QROOT=/opt/intelFPGA_lite/25.1std

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates locales python3 make rsync zip file \
        libglib2.0-0 libsm6 libice6 libx11-6 libxext6 libxi6 libxrender1 \
        libxrandr2 libxtst6 libxft2 libxcb1 libfontconfig1 libfreetype6 \
        libncurses5 libncursesw5 libtinfo5 libstdc++6 libdbus-1-3 \
        libpng16-16 libbz2-1.0 libssl3 libxcursor1 libxinerama1 libxfixes3 \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# Unattended install of Quartus Lite + Cyclone V device support only.
# The installer picks up any *.qdz sitting next to the .run automatically.
RUN set -eux; \
    test -x /dl/QuartusLiteSetup-${QVER}.${QBUILD}-linux.run; \
    test -f /dl/cyclonev-${QVER}.${QBUILD}.qdz; \
    /dl/QuartusLiteSetup-${QVER}.${QBUILD}-linux.run \
        --mode unattended --unattendedmodeui none --accept_eula 1 \
        --installdir ${QROOT}; \
    rm -rf ${QROOT}/uninstall ${QROOT}/logs /tmp/* /root/.altera* || true; \
    test -x ${QROOT}/quartus/bin/quartus_sh

ENV QUARTUS_ROOTDIR=${QROOT}/quartus
ENV PATH=${QROOT}/quartus/bin:${PATH}
# Quartus writes ~/.altera.quartus; we run as the host uid with no passwd entry.
ENV HOME=/tmp

# Sanity: the binary must run on this userland.
RUN quartus_sh --version

WORKDIR /work
